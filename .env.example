DATABASE_URL="file:./dev.db"
PORT=4000
DEMO_MODE=true
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# true uses the DataForSEO sandbox host; set false for production API.
DATAFORSEO_SANDBOX=true
YOUTUBE_API_KEY=
WAPPALYZER_API_KEY=
META_AD_LIBRARY_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
# Optional HTTP or SOCKS5 proxy, for example http://127.0.0.1:7892.
HTTPS_PROXY=
# Semrush 标准 SEO API（临时的闲鱼共享 Key 也能用；国内可直连，不走代理）
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us
# 单次批量任务最多消耗的 units，防止共享账号配额被一次跑光
SEMRUSH_UNIT_BUDGET=48000
# 数据源偏好：semrush | dataforseo | auto（auto 表示 Semrush 有 Key 时优先）
DATA_PROVIDER=auto
# 外链机会挖掘与 Sheets 同步
MAIN_SITE_DOMAIN=
MAIN_KEYWORDS=
OUTREACH_MIN_DR=20
OUTREACH_DOFOLLOW_ONLY=true
OUTREACH_SPAM_WORDS=casino,porn,viagra,payday,betting,gambling,loan
OUTREACH_EXCLUDE_SPAM=true
GOOGLE_SHEETS_WEBAPP_URL=
# 可选 Ahrefs 适配器预留，不配置时始终使用 DataForSEO
AHREFS_API_KEY=
